# Shared AWS harness config — copy to .env or generate with `make env`.
# .env is gitignored; it holds live EC2 IPs. Read by both the root Makefile
# and each product's Makefile (e.g. braft/Makefile); product-specific run
# knobs (PORT, SYNC, THREADS, ...) live in each product's own README, not here.

# Public IPs (ssh/scp targets)
NODE1=
NODE2=
NODE3=
CLIENT=

# Private IPs (raft peer list, traffic stays inside the placement group)
NODE1_PRIV=
NODE2_PRIV=
NODE3_PRIV=

SSH_USER=ubuntu
SSH_KEY=~/.ssh/id_rsa

# CIDR allowed to reach ssh and the raft stats port, e.g. from:
#   curl -s https://checkip.amazonaws.com
# Required by deploy/main.tf; without it terraform prompts on every
# deploy/destroy. Update if your IP changes.
SSH_INGRESS_CIDR=
